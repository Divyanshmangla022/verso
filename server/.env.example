# Verso server configuration
PORT=4000
MONGODB_URI=mongodb://localhost:27017/verso
# Required in production (>= 24 chars). Any long random string.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Origin of the Vite dev server (CORS). Unused in single-process prod.
CLIENT_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=10
MAX_VERSIONS_PER_DOC=20
# Optional: enables the full AI layer. Without it, honest heuristic fallbacks run.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Rate limits (requests per 5-minute window)
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_AI_MAX=60
RATE_LIMIT_UPLOAD_MAX=40
# Number of reverse proxies in front of this process (0 locally, 1 on Render).
# Rate limiting keys on the client address, which is only correct when Express
# knows how far to trust X-Forwarded-For. Never set this higher than the real
# hop count: that would let clients spoof their address.
TRUST_PROXY_HOPS=0
